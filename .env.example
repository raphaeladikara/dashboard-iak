# ── Supabase (Project Settings → Database → Connection string) ─────────────
# Koneksi aplikasi: Transaction pooler (port 6543) dengan role khusus aplikasi
# `iak_dashboard` yang dibuat oleh supabase/schema.sql. Formatnya:
#   postgresql://iak_dashboard.<PROJECT_REF>:<APP_DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
# Variabel ini juga wajib diisi di Vercel (Settings → Environment Variables).
DATABASE_URL=

# Hanya untuk `npm run setup` di laptop (JANGAN dipasang di Vercel).
# Session pooler (port 5432) dengan role `postgres` dan Database Password project:
#   postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
DATABASE_URL_ADMIN=
# Password untuk role `iak_dashboard` (dipakai juga di DATABASE_URL di atas)
APP_DB_PASSWORD=

# ── Aplikasi ───────────────────────────────────────────────────────────────
# Kunci untuk menandatangani cookie session, minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Wajib diisi juga di Vercel.
SESSION_SECRET=

# Akun admin awal yang dibuat oleh `npm run setup` (tidak perlu di Vercel)
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=
